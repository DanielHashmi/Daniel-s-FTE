# Copy this file to `.env` (repo root). Do not commit real secrets.

# Safety: when true, external actions are simulated and browser posting is skipped.
DRY_RUN=true
# Forces dry-run in approval execution paths even when files are approved.
DEV_MODE=false

# Reasoning engine used by the Python plan manager ("claude" or "qwen").
REASONING_ENGINE=qwen
# Optional explicit Python path on Windows if `python` is a Store stub.
# PYTHON_EXE=C:\Path\to\python.exe

# Work-zone specialization (Platinum)
AGENT_ROLE=local
AGENT_ID=local-agent-001
STRICT_WORK_ZONES=true

# Dashboard authentication
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-too

# (Optional) override how the dashboard locates the project root.
# PROJECT_ROOT=C:\path\to\Daniel's FTE

# Qwen CLI
QWEN_PATH=qwen
QWEN_TIMEOUT_SECONDS=120

# Facebook (official Graph API with optional Playwright fallback)
# Global Graph API version override for Meta APIs in social-mcp
META_GRAPH_API_VERSION=v19.0

# Facebook Graph API (recommended official mode)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Facebook MCP post mode: graph_api | playwright
FACEBOOK_POST_METHOD=graph_api

# Facebook Playwright fallback settings (used only when FACEBOOK_POST_METHOD=playwright)
FACEBOOK_COMPOSER_URL=
FACEBOOK_SESSION_DIR=facebook_session
FACEBOOK_HEADLESS=false
FACEBOOK_LOGIN_WAIT_SECONDS=600
FACEBOOK_KEEP_OPEN_SECONDS=0
# FACEBOOK_BROWSER_CHANNEL=chrome

# Gmail watcher (OAuth flow is interactive; keep off unless you intend to run it)
GMAIL_ENABLE_OAUTH_FLOW=false

# Watcher toggles (enable/disable without code edits)
WATCHER_GMAIL_ENABLED=true
WATCHER_LINKEDIN_ENABLED=true
WATCHER_WHATSAPP_ENABLED=true
WATCHER_BANKING_ENABLED=true
WATCHER_FILESYSTEM_ENABLED=true
WATCHER_ODOO_ENABLED=true

# Odoo (optional)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Social APIs (optional placeholders)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_CONTAINER_MAX_ATTEMPTS=10
INSTAGRAM_CONTAINER_POLL_MS=2000

# Instagram official mode (Graph API) or Playwright fallback
# Playwright settings below are used only when INSTAGRAM_POST_METHOD=playwright
INSTAGRAM_POST_METHOD=graph_api
INSTAGRAM_COMPOSER_URL=https://www.instagram.com/
INSTAGRAM_SESSION_DIR=instagram_session
INSTAGRAM_HEADLESS=false
INSTAGRAM_BROWSER_CHANNEL=default
INSTAGRAM_PROFILE_MODE=session
INSTAGRAM_PROFILE_FALLBACK_TO_SESSION=true
INSTAGRAM_CONNECT_EXISTING_BROWSER=false
INSTAGRAM_CDP_URL=http://127.0.0.1:9222
INSTAGRAM_CDP_ATTACH_TIMEOUT_MS=15000
INSTAGRAM_CDP_AUTO_START=false
INSTAGRAM_CDP_ALLOW_BROWSER_RESTART=false
INSTAGRAM_CDP_START_TIMEOUT_SECONDS=12
INSTAGRAM_LOGIN_WAIT_SECONDS=600
INSTAGRAM_KEEP_OPEN_SECONDS=0

# WhatsApp Cloud API (official)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional override; defaults to META_GRAPH_API_VERSION when unset
WHATSAPP_API_VERSION=
WHATSAPP_VERIFY_TOKEN=
# Domain folder under AI_Employee_Vault/Needs_Action/ for inbound webhook messages
WHATSAPP_WEBHOOK_DOMAIN=personal

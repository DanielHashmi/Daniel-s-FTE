# Cloud deployment environment (do not commit real values)

# Domain / TLS
ODOO_DOMAIN=odoo.example.com
ACME_EMAIL=ops@example.com

# Odoo / Postgres
ODOO_IMAGE=odoo:19.0
ODOO_POSTGRES_DB=postgres
ODOO_POSTGRES_USER=odoo
ODOO_POSTGRES_PASSWORD=change_me_strong_password

# Backup policy
ODOO_BACKUP_INTERVAL_SECONDS=86400
ODOO_BACKUP_RETENTION_SECONDS=1209600

# Cloud orchestrator role
AGENT_ROLE=cloud
CLOUD_AGENT_ID=cloud-agent-001
REASONING_ENGINE=qwen
DEV_MODE=true
STRICT_WORK_ZONES=true

# Optional explicit python path for PM2 cloud host
# PYTHON_EXE=/usr/bin/python3
